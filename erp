<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ERP Mini - Stok Gudang</title>
    
    <style>
        body {
            background-color: #f4f6f9;
            font-family: Arial, sans-serif;
            color: #333333;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 950px;
            margin: 0 auto;
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }

        h2 {
            margin: 0;
            color: #2c3e50;
        }

        /* Kartu Ringkasan Informasi */
        .summary-card {
            background-color: #e8f4fd;
            border-left: 4px solid #3498db;
            padding: 12px 18px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            color: #2c3e50;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .toolbar {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        input[type="text"] {
            padding: 9px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
            width: 180px;
        }

        input[type="text"]:focus {
            border-color: #2c3e50;
        }

        .btn-tambah {
            background-color: #27ae60;
            color: white;
            border: none;
            padding: 10px 16px;
            font-size: 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-tambah:hover {
            background-color: #219653;
        }

        .btn-reset {
            background-color: #e67e22;
            color: white;
            border: none;
            padding: 10px 14px;
            font-size: 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-reset:hover {
            background-color: #d35400;
        }

        .btn-hapus {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        .btn-hapus:hover {
            background-color: #c0392b;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #2c3e50;
            color: white;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        .badge-aman {
            background-color: #e2f9e1;
            color: #27ae60;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-warning {
            background-color: #fef3d6;
            color: #d48806;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-habis {
            background-color: #fde8e8;
            color: #c0392b;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body onload="muatData()">

    <div class="container">
        <div class="header-flex">
            <div>
                <h2>📦 Modul Inventaris Gudang</h2>
                <p style="margin: 5px 0 0 0; color: #666;">Sistem ERP Mini dengan Database Lokal & Pencarian Cepat.</p>
            </div>
            <div class="toolbar">
                <input type="text" id="inputCari" placeholder="Cari barang..." onkeyup="cariBarang()">
                <button class="btn-tambah" onclick="tambahBarang()">+ Tambah</button>
                <button class="btn-reset" onclick="resetData()">Reset Data</button>
            </div>
        </div>

        <!-- Kotak Informasi Ringkasan -->
        <div class="summary-card">
            <span id="infoTotalItem">Total Jenis Barang: 0</span>
            <span id="infoTotalStok">Akumulasi Stok: 0 unit</span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID Barang</th>
                    <th>Nama Produk</th>
                    <th>Kategori</th>
                    <th>Stok</th>
                    <th>Harga Satuan</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody id="tabel-barang">
                <!-- Data dimuat dinamis oleh JavaScript -->
            </tbody>
        </table>
    </div>

    <script>
        let dataBarang = [
            { id: "PRD-001", nama: "Power Drill Makita", kategori: "Tools / Perkakas", stok: 15, harga: 850000 },
            { id: "PRD-002", nama: "Mata Bor Besi Set", kategori: "Aksesori", stok: 42, harga: 75000 },
            { id: "PRD-003", nama: "Oli Mesin Industri", kategori: "Maintenance", stok: 3, harga: 250000 }
        ];

        // Format angka ke format Rupiah
        function formatRupiah(angka) {
            return "Rp " + angka.toLocaleString("id-ID");
        }

        // Fungsi Render Tabel & Update Ringkasan
        function renderTabel(dataList = dataBarang) {
            let tbody = document.getElementById("tabel-barang");
            tbody.innerHTML = ""; 

            if (dataList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #888;">Tidak ada data barang ditemukan.</td></tr>`;
                document.getElementById("infoTotalItem").innerText = `Total Jenis Barang: 0`;
                document.getElementById("infoTotalStok").innerText = `Akumulasi Stok: 0 unit`;
                return;
            }

            let totalStokKeseluruhan = 0;

            dataList.forEach((item, index) => {
                totalStokKeseluruhan += Number(item.stok);

                // Menentukan badge status berdasarkan jumlah stok
                let statusBadge = "";
                if (item.stok == 0) {
                    statusBadge = '<span class="badge-habis">Habis</span>';
                } else if (item.stok < 5) {
                    statusBadge = '<span class="badge-warning">Menipis</span>';
                } else {
                    statusBadge = '<span class="badge-aman">Aman</span>';
                }

                let hargaFormatted = typeof item.harga === 'number' ? formatRupiah(item.harga) : item.harga;

                let barisBaru = document.createElement("tr");
                barisBaru.innerHTML = `
                    <td>${item.id}</td>
                    <td>${item.nama}</td>
                    <td>${item.kategori}</td>
                    <td>${item.stok}</td>
                    <td>${hargaFormatted}</td>
                    <td>${statusBadge}</td>
                    <td><button class="btn-hapus" onclick="hapusBarang('${item.id}')">Hapus</button></td>
                `;
                tbody.appendChild(barisBaru);
            });

            // Update teks informasi di atas tabel
            document.getElementById("infoTotalItem").innerText = `Total Jenis Barang: ${dataBarang.length}`;
            document.getElementById("infoTotalStok").innerText = `Akumulasi Stok: ${totalStokKeseluruhan} unit`;
        }

        // Ambil data dari LocalStorage saat halaman dimuat
        function muatData() {
            let dataSimpanan = localStorage.getItem("erp_stok_barang");
            if (dataSimpanan) {
                dataBarang = JSON.parse(dataSimpanan);
            }
            renderTabel();
        }

        // Tambah Barang Baru
        function tambahBarang() {
            let id = prompt("Masukkan ID Barang (contoh: PRD-004):");
            if (!id) return;

            let nama = prompt("Masukkan Nama Produk:");
            if (!nama) return;

            let kategori = prompt("Masukkan Kategori:") || "Umum";
            let stok = parseInt(prompt("Masukkan Jumlah Stok:")) || 0;
            let hargaInput = prompt("Masukkan Harga Satuan (angka saja, contoh: 150000):") || "0";
            let harga = parseInt(hargaInput) || 0;

            dataBarang.push({ id, nama, kategori, stok, harga });
            localStorage.setItem("erp_stok_barang", JSON.stringify(dataBarang));
            
            document.getElementById("inputCari").value = "";
            renderTabel();
            alert("Barang berhasil ditambahkan!");
        }

        // Hapus Barang Berdasarkan ID
        function hapusBarang(idBarang) {
            if (confirm("Yakin ingin menghapus barang ini dari sistem?")) {
                dataBarang = dataBarang.filter(item => item.id !== idBarang);
                localStorage.setItem("erp_stok_barang", JSON.stringify(dataBarang));
                renderTabel();
            }
        }

        // Reset Data kembali ke default awal
        function resetData() {
            if (confirm("Reset data akan mengembalikan ke daftar awal. Lanjutkan?")) {
                localStorage.removeItem("erp_stok_barang");
                location.reload();
            }
        }

        // Fitur Pencarian Cepat
        function cariBarang() {
            let keyword = document.getElementById("inputCari").value.toLowerCase();
            let hasilPencarian = dataBarang.filter(item => 
                item.nama.toLowerCase().includes(keyword) || 
                item.id.toLowerCase().includes(keyword) ||
                item.kategori.toLowerCase().includes(keyword)
            );
            renderTabel(hasilPencarian);
        }
    </script>

</body>
</html>
